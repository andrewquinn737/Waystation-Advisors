[Unit]
Description=Waystation AI call coach (practice owners, call feedback, weekly retrain)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=waystation-ai
Group=waystation-ai
WorkingDirectory=/opt/waystation-ai/coach
# same env file (and Claude subscription token) as waystation-ai-worker
EnvironmentFile=/etc/waystation-ai/env
Environment=COACH_WORK_DIR=/opt/waystation-ai/coach/run
Environment=FASTEMBED_CACHE_PATH=/opt/waystation-ai/coach/models
ExecStart=/opt/waystation-ai/coach/.venv/bin/python /opt/waystation-ai/coach/worker.py
Restart=always
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/waystation-ai /home/waystation-ai
ProtectKernelTunables=true
ProtectControlGroups=true
MemoryMax=2G

[Install]
WantedBy=multi-user.target
